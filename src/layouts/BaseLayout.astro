---
/**
 * BaseLayout: the HTML document. Every page renders inside this.
 * Owns: <head> (SEO, icons, feeds), the skip link, header and footer.
 */
import '@/styles/global.css';
import { site } from '@config/site';
import { routes } from '@config/routes';
import type { PageSeo } from '@lib/seo';
import SEO from '@components/seo/SEO.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Blog`} href={routes.rss()} />
    <SEO seo={seo} />
    <!-- Escape hatch: a page can add extra <head> tags with slot="head" -->
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
