---
import { cx } from '@lib/utils';

interface Props {
  href?: string | undefined;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className } = Astro.props;

const variants = {
  primary: 'bg-brand-600 text-white hover:bg-brand-700',
  secondary: 'border border-line bg-white text-ink hover:border-brand-600 hover:text-brand-600',
  ghost: 'text-brand-600 hover:text-brand-700',
};
const sizes = { sm: 'h-9 px-4 text-sm', md: 'h-11 px-6 text-sm', lg: 'h-12 px-7 text-base' };

const classes = cx(
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors',
  variants[variant],
  sizes[size],
  className,
);
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
