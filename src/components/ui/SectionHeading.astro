---
/** Section heading. The page owns the single <h1>; sections always use <h2>. */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold tracking-tight text-balance md:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg text-pretty text-muted">{intro}</p>}
</div>
