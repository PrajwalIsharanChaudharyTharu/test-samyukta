---
import { routes } from '@config/routes';
import type { Service } from '@lib/content';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="group relative flex flex-col rounded-(--radius-card) border border-line bg-white p-6 transition-shadow hover:shadow-lg">
  <Heading class="text-lg font-semibold">
    <a href={routes.service(service.id)} class="after:absolute after:inset-0">
      {service.data.title}
    </a>
  </Heading>
  <p class="mt-2 flex-1 text-muted">{service.data.summary}</p>
  <span class="mt-4 text-sm font-semibold text-brand-600 group-hover:underline" aria-hidden="true">
    Learn more →
  </span>
</article>
