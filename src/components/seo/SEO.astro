---
/**
 * Renders every <head> SEO tag from one PageSeo object.
 * Only layouts use this component. Pages pass `seo` to their layout.
 */
import { site } from '@config/site';
import { auditSeo, resolveSeo, type PageSeo } from '@lib/seo';

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
const meta = resolveSeo(seo, Astro.url.pathname, Astro.site!);

// Dev-only guardrail: warns in the terminal while you work.
if (import.meta.env.DEV && !seo.noindex) {
  for (const issue of auditSeo(meta)) console.warn(`[seo] ${Astro.url.pathname}: ${issue}`);
}
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
<meta name="robots" content={meta.robots} />

<!-- Open Graph (Facebook, LinkedIn, WhatsApp, Slack…) -->
<meta property="og:type" content={meta.ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:alt" content={meta.ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{meta.article && (
  <>
    <meta property="article:published_time" content={meta.article.publishedTime.toISOString()} />
    {meta.article.modifiedTime && (
      <meta property="article:modified_time" content={meta.article.modifiedTime.toISOString()} />
    )}
    {meta.article.authors?.map((name) => (
      <meta property="article:author" content={name} />
    ))}
    {meta.article.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{site.twitterHandle && <meta name="twitter:site" content={`@${site.twitterHandle}`} />}
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />
<meta name="twitter:image:alt" content={meta.ogImageAlt} />
