---
import { routes } from '@config/routes';
import type { Crumb } from '@lib/nav';

interface Props {
  items: Crumb[];
}

// "Home" is always first, so pages never have to add it.
const items: Crumb[] = [{ label: 'Home', href: routes.home() }, ...Astro.props.items];
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="text-ink">
            {item.label}
          </span>
        ) : (
          <a href={item.href} class="hover:text-brand-600">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
