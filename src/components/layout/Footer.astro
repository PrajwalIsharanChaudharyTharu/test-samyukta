---
import { site } from '@config/site';
import { footerNav } from '@config/routes';
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <Container class="grid gap-10 py-14 md:grid-cols-4">
    <div>
      <p class="text-lg font-bold">{site.name}</p>
      <p class="mt-2 text-sm text-muted">{site.tagline}</p>
      <address class="mt-4 text-sm text-muted not-italic">
        {`${site.contact.address.city}, Nepal`}
        <br />
        <a href={`mailto:${site.contact.email}`} class="hover:text-brand-600">
          {site.contact.email}
        </a>
      </address>
    </div>

    {footerNav.map((group) => (
      <nav aria-label={group.title}>
        <p class="text-sm font-semibold">{group.title}</p>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-600">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </Container>

  <Container class="border-t border-line py-6 text-sm text-muted">
    {`© ${year} ${site.legalName} All rights reserved.`}
  </Container>
</footer>
