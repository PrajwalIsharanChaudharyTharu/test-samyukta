---
import { site } from '@config/site';
import { mainNav, routes } from '@config/routes';
import { isActivePath } from '@lib/nav';

const path = Astro.url.pathname;
---

<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="mx-auto flex h-16 max-w-(--container-content) items-center justify-between px-6"
  >
    <a href={routes.home()} class="font-bold">
      {site.name}
    </a>
    <ul class="flex gap-6 text-sm">
      {mainNav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActivePath(path, item.href) ? 'page' : undefined}
            class="text-muted hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-brand-600"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
