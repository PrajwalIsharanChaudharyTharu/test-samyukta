---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/layout/Container.astro';
import Button from '@components/ui/Button.astro';
import { pages } from '@config/pages';
import { routes } from '@config/routes';
---

<BaseLayout seo={pages.notFound}>
  <Container class="py-32 text-center">
    <p class="text-sm font-semibold text-brand-600">404</p>
    <h1 class="mt-2 text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted">Sorry, we could not find that page.</p>
    <Button href={routes.home()} class="mt-8">
      Back to home
    </Button>
  </Container>
</BaseLayout>
