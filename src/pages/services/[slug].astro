---
/**
 * /services/<slug> — one page per service Markdown file.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/layout/Container.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import { routes } from '@config/routes';
import { getServices, type Service } from '@lib/content';
import { serviceSchema } from '@lib/schema';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const url = routes.service(service.id);
const seo = {
  title: data.seo?.title ?? `${data.title} Services`,
  description: data.seo?.description ?? data.summary,
  noindex: data.seo?.noindex,
};
---

<PageLayout
  seo={seo}
  heading={data.title}
  intro={data.summary}
  breadcrumbs={[
    { label: 'Services', href: routes.services() },
    { label: data.title, href: routes.service(service.id) },
  ]}
  schema={[serviceSchema({ title: data.title, description: seo.description, url: url }, Astro.site!)]}
>
  <Container class="grid gap-12 py-16 lg:grid-cols-3">
    <div class="prose prose-lg max-w-none lg:col-span-2">
      <Content />
    </div>

    {data.features.length > 0 && (
      <aside class="h-fit rounded-(--radius-card) border border-line bg-surface p-6">
        <h2 class="font-semibold">What's included</h2>
        <ul class="mt-4 space-y-2 text-muted">
          {data.features.map((feature) => (
            <li>{`✓ ${feature}`}</li>
          ))}
        </ul>
      </aside>
    )}
  </Container>

  <CtaBanner />
</PageLayout>
