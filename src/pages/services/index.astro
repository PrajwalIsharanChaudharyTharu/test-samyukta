---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/layout/Container.astro';
import ServiceCard from '@components/sections/ServiceCard.astro';
import { pages } from '@config/pages';
import { routes } from '@config/routes';
import { getServices } from '@lib/content';

const services = await getServices();
---

<PageLayout
  seo={pages.services}
  heading="Services"
  intro="The capabilities we bring to every engagement."
  breadcrumbs={[{ label: 'Services', href: routes.services() }]}
>
  <Container class="grid gap-6 py-16 md:grid-cols-3">
    {services.map((service) => (
      <ServiceCard service={service} headingLevel="h2" />
    ))}
  </Container>
</PageLayout>
